load("@rules_python//python:defs.bzl", "py_library")
load("@deps//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        requirement("python-dotenv"),
        requirement("requests"),
    ],
)

py_library(
    name = "comment",
    srcs = ["comment.py"],
)

py_library(
    name = "issue",
    srcs = ["issue.py"],
    deps = [
        ":client",
        ":comment",
    ],
)

py_library(
    name = "repo",
    srcs = ["repo.py"],
    deps = [
        ":client",
        ":issue",
    ],
)
