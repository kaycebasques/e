load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/uv:lock.bzl", "lock")
load("@deps//:requirements.bzl", "requirement")

lock(
    name = "deps",
    srcs = ["deps.in"],
    out = "deps.lock",
)

py_library(
    name = "project",
    srcs = ["project.py"],
    data = ["project.json"],
    deps = ["//github:repo"],
)

py_binary(
    name = "index",
    srcs = ["index.py"],
    main = "index.py",
    data = ['.env'],
    deps = [
        ":project",
        "//github:client",
        requirement("google-genai"),
        requirement("python-dotenv"),
    ],
)
